# Public service
APP_NAME=Instagram MCP by Nabux
PUBLIC_BASE_URL=https://ig.nabuxai.com
APP_SECRET_KEY=
DATA_DIR=/data
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Meta for Developers — Instagram API with Instagram Login
# Create/configure your Meta app, enable Instagram API, and add this exact redirect URI:
IG_APP_ID=
IG_APP_SECRET=
IG_REDIRECT_URI=https://ig.nabuxai.com/instagram/callback
IG_GRAPH_VERSION=v26.0
IG_GRAPH_BASE=https://graph.instagram.com
IG_AUTH_URL=https://www.instagram.com/oauth/authorize
IG_TOKEN_URL=https://api.instagram.com/oauth/access_token
IG_SCOPES=instagram_business_basic,instagram_business_content_publish,instagram_business_manage_comments,instagram_business_manage_messages,instagram_business_manage_insights

# Shared ONLY between this gateway and trusted Nabux backends such as NabuGen.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_SERVICE_TOKEN=

# Meta Webhooks (Instagram messaging/comments callback: /webhook)
# Pick any random string yourself and paste the SAME string into the Meta app's
# Webhooks "Verify Token" field. Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
IG_WEBHOOK_VERIFY_TOKEN=
# Where a verified DM/comment is relayed to become a CRM lead. Authenticated
# with INTERNAL_SERVICE_TOKEN above — NabuCRM's INSTAGRAM_MCP_INTERNAL_TOKEN
# must be set to the exact same value.
NABUCRM_INBOUND_URL=https://crm.nabuxai.com/webhook/instagram-relay

# NabuCRM intake: every connected Instagram account is reported to NabuCRM as
# a person (NabuCRM docs/crm-intake.md). NABUGATE_SECRET must be the exact
# value NabuCRM holds; while it is empty the reports queue up and wait.
CRM_INTAKE_URL=https://crm.nabuxai.com/api/v1/crm/intake
CRM_INTAKE_ENABLED=true
NABUGATE_SECRET=

# The Facebook app that owns this Instagram Login product. A Meta app has ONE
# webhook callback per product; point both the Instagram product and the
# Page/Messenger product at {PUBLIC_BASE_URL}/webhook (same verify token).
# Page deliveries are signed with FB_APP_SECRET, Instagram ones with
# IG_APP_SECRET — both are accepted.
FB_APP_ID=
FB_APP_SECRET=

# Other products that share this Meta app and keep their own Meta webhook
# handler (e.g. Zooey). Every verified delivery is forwarded to each URL
# byte-for-byte with Meta's own X-Hub-Signature-256, so they verify it with the
# same app secret as if Meta had called them directly. Comma-separated.
META_RELAY_TARGETS=https://app.zoeyhq.website/api/channels/meta/webhook

# NabuAuth (https://auth.nabuxai.com). Leave the client id blank to keep the
# legacy per-browser owner. Register the redirect URI in NabuAuth apps.yaml
# before setting the secret. See README.
NABUAUTH_URL=https://auth.nabuxai.com
NABUAUTH_CLIENT_ID=
NABUAUTH_CLIENT_SECRET=
NABUAUTH_REDIRECT_URI=https://ig.nabuxai.com/auth/nabu/callback
NABUAUTH_SCOPES=openid profile email

# Optional shared Postiz app. Each login can save its own app on the dashboard.
# These env vars are used only when that login has not saved one.
# Redirect URL to enter in that form: {PUBLIC_BASE_URL}/postiz/callback
# App name: Nabux Instagram
POSTIZ_FRONTEND_URL=
# Self-hosted default is {POSTIZ_FRONTEND_URL}/api. Set this for Postiz Cloud (https://api.postiz.com).
POSTIZ_API_URL=
POSTIZ_CLIENT_ID=
POSTIZ_CLIENT_SECRET=

# MCP OAuth/token lifetimes
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=7776000
AUTH_CODE_TTL=600
COOKIE_TTL=2592000
META_STATE_TTL=900

# Content calendar. Naive scheduled times use this zone unless the owner sets one.
DEFAULT_TIMEZONE=Asia/Muscat
# Transient publish failures retry this many times (default 5). Each error is kept.
SCHEDULE_MAX_ATTEMPTS=5

# Persistent media library. Coolify must mount a volume at this path.
# The compose file already mounts instagram-mcp-data on /data, which covers
# the default. Do not point MEDIA_DIR at the container's writable layer.
# If nginx terminates TLS in front of Coolify, set client_max_body_size to at
# least MEDIA_MAX_BYTES. Traefik (Coolify's proxy) does not limit body size.
MEDIA_DIR=/data/media
MEDIA_MAX_BYTES=1073741824
MEDIA_UPLOAD_GRANT_TTL=900

# HTTP / media processing
HTTP_TIMEOUT=45
PUBLISH_POLL_SECONDS=2
PUBLISH_POLL_ATTEMPTS=45

# Time before unpublished staged images expire and are deleted (seconds)
STAGED_MEDIA_TTL=14400
